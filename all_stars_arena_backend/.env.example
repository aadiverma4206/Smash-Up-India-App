# ALL STARS ARENA Production Environment Config
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/all_stars_arena

# JWT Secrets
JWT_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend / Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=ALL STARS ARENA <no-reply@allstarsarena.com>

# Firebase Admin SDK Configuration
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
FIREBASE_PROJECT_ID=all-stars-arena

# Confirmed CCTV / Dahua XVR Credentials & Network Settings
CAMERA_HOST=192.168.1.2
CAMERA_RTSP_PORT=554
CAMERA_TCP_PORT=37777
CAMERA_HTTP_PORT=80
CAMERA_USERNAME=admin
CAMERA_PASSWORD=admin@123
CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0
CAMERA_PROTOCOL=rtsp
CAMERA_SERIAL_NUMBER=3L04789PAZ01138
CAMERA_DEVICE_NAME=Botivate

# CCTV Security Encryption (32-byte key for AES-256-GCM encryption of RTSP credentials)
CCTV_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CAMERA_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CAMERA_CONNECTION_TIMEOUT_MS=5000
CAMERA_RECONNECT_INTERVAL_MS=5000

# Match Recording Workflow
RECORDING_OUTPUT_DIR=./recordings
RECORDING_TEMP_DIR=temp_recordings
RECORDING_DURATION_MINUTES=120
RECORDING_POST_MATCH_MINUTES=15
RECORDING_SEGMENT_SECONDS=300
RECORDING_MAX_RETRIES=3
RECORDING_MAX_CONCURRENT=5
FFMPEG_PATH=ffmpeg

# S3-Compatible Object Storage for Match Recordings
AWS_REGION=ap-south-1
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=all-stars-arena-recordings
AWS_S3_BUCKET_NAME=all-stars-arena-recordings
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_S3_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_ENDPOINT=
