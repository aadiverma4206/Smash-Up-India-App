
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
BACKEND_URL=http://localhost:5000
# Auto-kill previous stale process on port 5000 in development (true/false)
AUTO_FREE_PORT=true
#  npm run format
#  npm run format:check
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/all_stars_arena

JWT_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret

RESEND_API_KEY=re_yourResendApiKeyHere
EMAIL_FROM="ALL STARS ARENA <no-reply@yourdomain.com>"
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

FIREBASE_PROJECT_ID=your-firebase-project-id
CAMERA_HOST=192.168.1.100
CAMERA_RTSP_PORT=554
CAMERA_TCP_PORT=37777
CAMERA_HTTP_PORT=80
CAMERA_USERNAME=your_dvr_username
CAMERA_PASSWORD=your_dvr_password
CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0
CAMERA_PROTOCOL=rtsp
CAMERA_SERIAL_NUMBER=YOUR_DEVICE_SERIAL_NUMBER
CAMERA_DEVICE_NAME=Turf_Camera_Main

CCTV_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CAMERA_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CAMERA_CONNECTION_TIMEOUT_MS=5000
CAMERA_RECONNECT_INTERVAL_MS=5000

RECORDING_OUTPUT_DIR=./recordings
RECORDING_TEMP_DIR=temp_recordings
RECORDING_DURATION_MINUTES=120
RECORDING_POST_MATCH_MINUTES=15
RECORDING_SEGMENT_SECONDS=300
RECORDING_MAX_RETRIES=3
RECORDING_MAX_CONCURRENT=5

FFMPEG_PATH=ffmpeg

AWS_REGION=ap-south-1
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=your-match-recordings-bucket
AWS_S3_BUCKET_NAME=your-match-recordings-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_ACCESS_KEY_ID=your_aws_access_key_id
AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_ENDPOINT=
